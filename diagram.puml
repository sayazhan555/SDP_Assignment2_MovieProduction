@startuml
top to bottom direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

package "Factory Method" {

    interface Visual {
        +createScene()
        +getProductionTime() : int
    }

    class ActionVisual
    class DocumentaryVisual
    class AnimationVisual

    abstract class VisualCreator {
        +createVisual() : Visual
        +produceVisualScene()
    }

    class ActionVisualCreator
    class DocumentaryVisualCreator
    class AnimationVisualCreator

    Visual <|.. ActionVisual
    Visual <|.. DocumentaryVisual
    Visual <|.. AnimationVisual

    VisualCreator <|-- ActionVisualCreator
    VisualCreator <|-- DocumentaryVisualCreator
    VisualCreator <|-- AnimationVisualCreator
}

package "Abstract Factory" {

    interface Sound {
        +recordSound()
        +getProductionTime() : int
    }

    interface Editing {
        +edit()
        +getProductionTime() : int
    }

    interface MovieProductionFactory {
        +createVisual() : Visual
        +createSound() : Sound
        +createEditing() : Editing
    }

    class ActionProductionFactory
    class DocumentaryProductionFactory
    class AnimationProductionFactory
    class HorrorProductionFactory

    class ActionSound
    class DocumentarySound
    class AnimationSound
    class HorrorSound

    class ActionEditing
    class DocumentaryEditing
    class AnimationEditing
    class HorrorEditing

    class HorrorVisual

    MovieProductionFactory <|.. ActionProductionFactory
    MovieProductionFactory <|.. DocumentaryProductionFactory
    MovieProductionFactory <|.. AnimationProductionFactory
    MovieProductionFactory <|.. HorrorProductionFactory

    Sound <|.. ActionSound
    Sound <|.. DocumentarySound
    Sound <|.. AnimationSound
    Sound <|.. HorrorSound

    Editing <|.. ActionEditing
    Editing <|.. DocumentaryEditing
    Editing <|.. AnimationEditing
    Editing <|.. HorrorEditing

    Visual <|.. HorrorVisual
}

class Main
class FactorySelector {
    +selectFactory(choice : int) : MovieProductionFactory
}

class MovieProduction {
    -visual : Visual
    -sound : Sound
    -editing : Editing
    +prepareProduction()
    +produceScene()
    +finalizeProduction()
}

Main --> FactorySelector : uses
Main --> MovieProduction : creates

FactorySelector --> MovieProductionFactory : selects

MovieProduction --> MovieProductionFactory : uses
MovieProduction --> Visual
MovieProduction --> Sound
MovieProduction --> Editing

@enduml